apiVersion: v1
metadata:
  name: '{{ cluster_item.name }}'
baseDomain: {{ base_domain }}
controlPlane:
  hyperthreading: Enabled
  name: master
  replicas: 1
  platform:
    aws:
      zones:
      - {{ cluster_item.zone }}
      rootVolume:
        iops: {{ cluster_item.master_root_volume_iops }}
        size: {{ cluster_item.master_root_volume_size }}
        type: {{ cluster_item.master_root_volume_type }}
      type: {{ cluster_item.master_instance_type }}
compute:
- hyperthreading: Enabled
  name: 'worker'
  replicas: 0 # SNO/Compact typically 0 workers if masters are schedulable, or >0 if separate
  platform:
    aws:
      rootVolume:
        iops: {{ cluster_item.worker_root_volume_iops }}
        size: {{ cluster_item.worker_root_volume_size }}
        type: {{ cluster_item.worker_root_volume_type }}
      type: {{ cluster_item.worker_instance_type }}
      zones:
      - {{ cluster_item.zone }}
networking:
  networkType: OVNKubernetes
  clusterNetwork:
  - cidr: {{ cluster_item.cluster_network_cidr }}
    hostPrefix: 23
  machineNetwork:
  - cidr: {{ cluster_item.machine_cidr }}
  serviceNetwork:
  - {{ cluster_item.service_network_cidr }}
platform:
  aws:
    region: {{ cluster_item.region }}
pullSecret: "" # Injected by Hive
sshKey: |-
  {{ ssh_keypair.public_key | indent(2) }}

